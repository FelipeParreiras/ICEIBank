# Identidade da instância: 0, 1 ou 2
ICEIBANK_AGENCIA_ID=0

# Dois últimos dígitos da matrícula/RA, quando necessário no laboratório
ICEIBANK_PORT_OFFSET=0

# Substituir localmente por uma chave longa e aleatória; nunca versionar o .env
ICEIBANK_JWT_SECRET=change-me-locally
ICEIBANK_JWT_EXPIRATION_MINUTES=30

ICEIBANK_LOG_LEVEL=INFO
